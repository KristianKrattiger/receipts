SOLARI_API_KEY=slr_live_paste_your_key_here
ANTHROPIC_API_KEY=sk-ant-paste_your_key_here
ANTHROPIC_WORKSPACE_ID=wrkspc_optional_only_for_identity_linked_keys

# Only needed to read Reddit, via `npm run login`. Automating a logged-in
# account is contrary to Reddit's user agreement; see the verified-egress spec.
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Reddit, read through its official API with an app-only token.
# Create a "script" app at https://www.reddit.com/prefs/apps to get these.
# App-only access is read-only and acts as an application, not as a person.
REDDIT_CLIENT_ID=your_reddit_app_client_id
REDDIT_CLIENT_SECRET=your_reddit_app_secret
REDDIT_USER_AGENT=receipts/0.1 (by /u/your_username)
